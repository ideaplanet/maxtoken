{
  "name": "maxtoken",
  "version": "2.0.0",
  "description": "Lightweight MCP server for GLM & Kimi Coding Plan balance query and utilization statistics.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "glm",
    "kimi",
    "coding-plan",
    "token-balance",
    "utilization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideaplanet/maxtoken.git"
  },
  "homepage": "https://github.com/ideaplanet/maxtoken#readme",
  "bugs": {
    "url": "https://github.com/ideaplanet/maxtoken/issues"
  },
  "type": "module",
  "bin": {
    "maxtoken": "./dist/index.js"
  },
  "files": [
    "dist",
    "tokens.example.json"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "npx tsx src/index.ts --config ./tokens.example.json",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
